name: SSC Telegram Polls

on:
  workflow_dispatch:

jobs:
  send-ssc-polls:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Run SSC Quiz Bot
        run: python poll.py
        env:
          BOT_TOKEN: ${{ secrets.BOT_TOKEN }}
          SSC_CHAT_ID: ${{ secrets.SSC_CHAT_ID }}
